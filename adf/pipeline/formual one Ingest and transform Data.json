					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/formula1-project/ingestion",
					"baseParameters": {
						"p_filedate": {
							"value": "@formatDateTime(pipeline().parameters.p_file_date,'yyyy-MM-dd')",
							"type": "Expression"
						},
						"p_datasource": {
							"value": "@variables('v_datasource')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "AzureDatabricks notebooks",
					"type": "LinkedServiceReference"
				}
			},
			{
